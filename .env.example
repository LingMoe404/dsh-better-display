# Optional. Unset (or empty) uses ~/.dsh. See resolveDshHome in src/skill-roots.ts.
DSH_HOME=

# Optional. Unset (or empty) uses ~/.agents. See resolveAgentsHome in src/skill-roots.ts.
DSH_AGENTS_HOME=

# Optional. Absolute path of a DeepSeek Harness checkout.
# Unset uses ~/.config/dshx/harness. Needed by the harness compat check inside npm run build, not by npm test.
DSHX_HARNESS=
